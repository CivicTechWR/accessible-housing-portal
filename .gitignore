# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# alternative lockfiles — package-lock.json is canonical
# contributors can use bun/deno/pnpm/yarn locally, but only
# package-lock.json is committed to avoid confusing Next.js
bun.lock
bun.lockb
deno.lock
deno.json
deno.jsonc
pnpm-lock.yaml
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Isolated local review data and builds
/.review/
/.next-review/
