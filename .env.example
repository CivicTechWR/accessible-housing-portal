DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/affordable_housing_portal
BETTER_AUTH_URL=http://localhost:3000
# Generate each secret separately with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
EMAIL_JOB_SECRET=replace-with-a-separate-32-character-secret
EMAIL_WORKER_ENABLED=true
# capture writes private local files and never contacts Resend. Production requires resend.
EMAIL_TRANSPORT=capture
EMAIL_CAPTURE_DIR=.review/emails
RESEND_API_KEY=
EMAIL_FROM=HomeHub <no-reply@example.com>
# Used only by npm run auth:admin. Remove after creating the first administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
